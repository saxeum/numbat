{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numbat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // No stable *.workers.dev hostname. PR previews use per-version URLs only.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.0.0",
    "BETTER_AUTH_URL": "https://foonix.net",
    "BYOK_KEK_VERSION": "1",
    // Provider request/response tracing. Off: traced bodies contain user
    // prompts. Enable only for a deliberate debugging window, then set back to
    // "0" and redeploy.
    "GATEWAY_LLM_LOGGING": "0",
    // Report limits: models per run, starts per user/hour, retention.
    "REPORT_PROBE_LIMIT": "200",
    "REPORT_RATE_LIMIT_PER_HOUR": "10",
    "REPORT_RETENTION_DAYS": "30",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "numbat-db",
      "database_id": "7aa958b9-c747-417f-9273-a50221c21f16",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "PROBE_QUEUE", "queue": "numbat-probe-runs" }],
    "consumers": [
      { "queue": "numbat-probe-runs", "max_batch_size": 1, "max_retries": 2 },
    ],
  },
  // No cron triggers. The report-retention sweep is no longer scheduled;
  // `scheduled` in src/index.ts stays so re-arming is config-only.
  // Keep the empty array: wrangler only PUTs /schedules when `triggers` is
  // present, so deleting this key would leave the old cron running on Cloudflare.
  // `triggers` is inheritable, so named envs (staging) get this too.
  "triggers": { "crons": [] },
  "routes": [{ "pattern": "foonix.net/api/*", "zone_name": "foonix.net" }],
  "env": {
    "staging": {
      "name": "numbat-api-staging",
      // Staging is not a public ingress: reach it through a route behind
      // Cloudflare Access if it is needed. No stable or per-version URL.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.0.0",
        "BYOK_KEK_VERSION": "1",
        "GATEWAY_LLM_LOGGING": "0",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "numbat-db-staging",
          "database_id": "e3f36ab5-1ea6-4ea0-89f1-de52d3897323",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "PROBE_QUEUE", "queue": "numbat-probe-runs-staging" },
        ],
        "consumers": [
          {
            "queue": "numbat-probe-runs-staging",
            "max_batch_size": 1,
            "max_retries": 2,
          },
        ],
      },
      "routes": [],
    },
    "preview": {
      "name": "numbat-api-preview",
      // The stable preview hostname is closed; PR previews use per-version URLs
      // and reach this Worker through the web Worker's service binding.
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.0.0",
        "BYOK_KEK_VERSION": "1",
        "GATEWAY_LLM_LOGGING": "0",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "numbat-db-preview",
          "database_id": "ccbb09e4-ea7c-47c7-aaa3-b068215afe69",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "PROBE_QUEUE", "queue": "numbat-probe-runs-preview" },
        ],
        "consumers": [
          {
            "queue": "numbat-probe-runs-preview",
            "max_batch_size": 1,
            "max_retries": 2,
          },
        ],
      },
      "routes": [],
    },
  },
}
