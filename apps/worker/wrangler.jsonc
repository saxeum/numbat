{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numbat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "foonix.net/api/*", "zone_name": "foonix.net" }],
}
