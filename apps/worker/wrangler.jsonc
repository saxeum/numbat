{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numbat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // No stable *.workers.dev hostname. PR previews use per-version URLs only.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.0.0",
    "BETTER_AUTH_URL": "https://foonix.net",
    "BYOK_KEK_VERSION": "1",
    // Provider request/response tracing. Bodies are truncated (8 KB) and the
    // provider key is never logged. Turn off by setting to "0" and redeploy.
    "GATEWAY_LLM_LOGGING": "1",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "numbat-db",
      "database_id": "7aa958b9-c747-417f-9273-a50221c21f16",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [{ "pattern": "foonix.net/api/*", "zone_name": "foonix.net" }],
  "env": {
    "staging": {
      "name": "numbat-api-staging",
      // Staging is not a public ingress: reach it through a route behind
      // Cloudflare Access if it is needed. No stable or per-version URL.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.0.0",
        "BYOK_KEK_VERSION": "1",
        "GATEWAY_LLM_LOGGING": "0",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "numbat-db-staging",
          "database_id": "e3f36ab5-1ea6-4ea0-89f1-de52d3897323",
          "migrations_dir": "migrations",
        },
      ],
      "routes": [],
    },
    "preview": {
      "name": "numbat-api-preview",
      // The stable preview hostname is closed; PR previews use per-version URLs
      // and reach this Worker through the web Worker's service binding.
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.0.0",
        "BYOK_KEK_VERSION": "1",
        "GATEWAY_LLM_LOGGING": "0",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "numbat-db-preview",
          "database_id": "ccbb09e4-ea7c-47c7-aaa3-b068215afe69",
          "migrations_dir": "migrations",
        },
      ],
      "routes": [],
    },
  },
}
