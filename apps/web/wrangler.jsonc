{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numbat-web",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "foonix.net", "custom_domain": true }],
}
