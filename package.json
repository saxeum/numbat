{
  "name": "numbat",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:lint": "redocly lint openapi/openapi.yaml",
    "api:bundle": "redocly bundle openapi/openapi.yaml -o apps/worker/openapi.json",
    "api:gen": "npm run api:bundle && openapi-zod-client openapi/openapi.yaml -o packages/api/src/schemas.ts --template ./openapi/zod-schemas.hbs",
    "api:check": "npm run api:gen && git diff --exit-code -- packages/api apps/worker/openapi.json",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "deploy:api": "npm run deploy -w apps/worker",
    "deploy:web": "npm run deploy -w apps/web"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.78.0",
    "concurrently": "^10",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "better-sqlite3": true,
    "@prisma/client": true
  }
}
